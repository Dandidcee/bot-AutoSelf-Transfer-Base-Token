# ============================================
#   KONFIGURASI SELF TRANSFER BOT - BASE NET
#   MULTI WALLET MODE
# ============================================

# Private key wallet (pisahkan dengan koma, tanpa spasi, tanpa 0x)
PRIVATE_KEYS=key_wallet1,key_wallet2,key_wallet3

# RPC Base Network
RPC_URL=https://mainnet.base.org

# Alamat token ERC-20 yang mau di-transfer
TOKEN_ADDRESS=0x53cd9Bf2bE680bf7192A2317f95BA8716ee49B07

# Jumlah token yang dikirim per TX
AMOUNT=1

# Berapa kali transfer per wallet
REPEAT_COUNT=5

# Delay antar pengulangan TX dalam 1 wallet (milidetik)
DELAY_BETWEEN_TX_MS=1000

# Delay antar wallet (milidetik)
DELAY_BETWEEN_WALLETS_MS=1000

# ============================================
#   JADWAL & TESTING
# ============================================

# Set true  = jadwalkan di TEST_TIME (untuk verifikasi)
# Set false = jadwalkan di 00:00 WIB (produksi)
TEST_MODE=true

# Jam test (HH:MM format WIB) - hanya berlaku jika TEST_MODE=true
TEST_TIME=22:20
